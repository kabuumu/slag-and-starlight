credit_reward = 25

[sub_resource type="Resource" id="Stage_3_hack"]
script = ExtResource("2_stage")
stage_id = "hack_mainframe"
journal_text = "Optional: Hack the Overseer's Mainframe to download the Seismic Blackbox telemetry logs."
