is_completed = false
xp_reward = 75
credit_reward = 0

[sub_resource type="Resource" id="Stage_4_kill"]
script = ExtResource("2_stage")
stage_id = "kill_unit_734b"
journal_text = "Defeat Unit 734-B at the Main Cargo Lift (Room 7) and ride the lift to Rust-Spire Outpost."
objective_type = 0
target_id = "unit_734b"
is_optional = false
is_completed = false
xp_reward = 150
credit_reward = 100

[resource]
script = ExtResource("1_quest")
quest_id = "dead_mans_switch"
id = "dead_mans_switch"
title = "Dead Man's Switch"
description = "Escape Sub-Level 04: The Deep Bore by restoring power to the Main Cargo Lift and recovering the Lift Override Keycard."
is_radiant = false
stages = Array[ExtResource("2_stage")]([SubResource("Stage_1_talk"), SubResource("Stage_2_fetch"), SubResource("Stage_3_hack"), SubResource("Stage_4_kill")])
current_stage_index = 0
reward_xp = 200
reward_credits = 100
