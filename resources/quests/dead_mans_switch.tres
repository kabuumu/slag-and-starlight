[gd_resource type="Resource" script_class="QuestResource" load_steps=7 format=3]

[ext_resource type="Script" path="res://scripts/resources/QuestResource.gd" id="1_quest"]
[ext_resource type="Script" path="res://scripts/resources/QuestStage.gd" id="2_stage"]

[sub_resource type="Resource" id="Stage_1_talk"]
script = ExtResource("2_stage")
stage_id = "talk_kael"
journal_text = "Speak with Kael at the Security Checkpoint in Room 3 to learn why Sub-Level 04 is locked down."
objective_type = 3
target_id = "kael"
is_optional = false
is_completed = false
xp_reward = 25
credit_reward = 0

[sub_resource type="Resource" id="Stage_2_fetch"]
script = ExtResource("2_stage")
stage_id = "fetch_keycard"
journal_text = "Retrieve the Lift Override Keycard from Overseer Vos's Office (Room 6)."
objective_type = 1
